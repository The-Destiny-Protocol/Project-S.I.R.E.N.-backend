# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this file to .env and fill in real values.
#                  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR_SUPABASE_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:<YOUR_UPSTASH_PASSWORD>@<YOUR_UPSTASH_ENDPOINT>:6379

# ── HiveMQ Cloud MQTT Broker (Free Tier — TLS + Username/Password) ───────────
MQTT_BROKER_URL=<YOUR_CLUSTER>.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=<YOUR_HIVEMQ_USERNAME>
MQTT_PASSWORD=<YOUR_HIVEMQ_PASSWORD>

# ── Security (JWT) ────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<YOUR_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Mapbox ────────────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=<YOUR_MAPBOX_TOKEN>
