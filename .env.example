# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this file to .env and fill in real values.
#                  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (PostGIS must be enabled on this database)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sih_ambulance

# ── HiveMQ Cloud MQTT Broker ──────────────────────────────────────────────────
MQTT_BROKER_URL=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_hivemq_username
MQTT_PASSWORD=your_hivemq_password

# Optional: set to "development" or "production"
APP_ENV=development
