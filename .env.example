# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this file to .env and fill in real values.
#                  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application / Render Configuration ───────────────────────────────────────
APP_ENV=production
# Render provides the PORT dynamically. Defaulting to 8000 for local testing.
PORT=8000
# Comma-separated list of allowed CORS origins (e.g. your Vercel/Render frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://your-frontend-domain.vercel.app

# ── Database (Supabase) ───────────────────────────────────────────────────────
# IMPORTANT: Use the Transaction Pooler string (usually port 6543 or ?pgbouncer=true)
# The backend will automatically sanitize `postgres://` to `postgresql://`
DATABASE_URL=postgresql://postgres:[YOUR_SUPABASE_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:<YOUR_UPSTASH_PASSWORD>@<YOUR_UPSTASH_ENDPOINT>:6379

# ── HiveMQ Cloud MQTT Broker (Free Tier — TLS + Username/Password) ───────────
MQTT_BROKER_URL=<YOUR_CLUSTER>.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=<YOUR_HIVEMQ_USERNAME>
MQTT_PASSWORD=<YOUR_HIVEMQ_PASSWORD>

# ── Security (JWT) ────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<YOUR_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Mapbox ────────────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=<YOUR_MAPBOX_TOKEN>

# ── Discord RoIP Gateway Bot ─────────────────────────────────────────────────
# Get your bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=<YOUR_DISCORD_BOT_TOKEN>
# Right-click a voice channel → Copy Channel ID (enable Developer Mode)
DISCORD_VOICE_CHANNEL_ID=<YOUR_VOICE_CHANNEL_ID>
# Optional: Webhook URL for text-based alerts in addition to voice
DISCORD_WEBHOOK_URL=<YOUR_DISCORD_WEBHOOK_URL>

# ── AWS (Amazon Polly TTS) ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_DEFAULT_REGION=ap-south-1
